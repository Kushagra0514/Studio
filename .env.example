# Optional server-side fallback for CLI/evaluation use. The local UI prompts
# each user for their own Groq key. Never commit a real key.
GROQ_API_KEY=

# Optional: configure Firecrawl for web ingestion/search.
# For a host-run backend with local Firecrawl, use http://localhost:3002.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=http://host.docker.internal:3002

# Safe local default. Compose overrides this with /app/data inside the container.
STUDIO_DATA_DIR=data

# Direct API upload limit in bytes (50 MiB). Nginx also enforces 50 MiB.
STUDIO_MAX_UPLOAD_BYTES=52428800
